# .gitignore for Node.js
node_modules/
.next/
dist/
build/
.env
.env.local
.env.*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.pem
.vercel
.turbo
coverage/
.vscode/
.idea/

# Prisma
prisma/migrations/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Misc
*.local

# Backups, secrets, credentials (PRIORIDAD ALTA)
.sprint*-safety-*
.sprint*-backup-*
*.bak
*.tmp
*.dump.gz
package-lock.json
yarn.lock
.env.development
.env.production
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*-credentials.json
secrets/
*.swp
*.swo
*~

# Documentación trackeable (rehabilitar paths ignorados más arriba)
!docs/
!docs/**
!.env.example
!docs/security/
!docs/security/**

# Re-ignore backups/secrets incluso dentro de paths rehabilitados
*.bak
*.tmp
.env
.env.local
.env.*.local
.env.development
.env.production
*.key
*.pem
*.p12
*.pfx
credentials.json
service-account*.json
*-credentials.json
secrets/
.env*
playwright-report/
test-results/
