# ============================================
# AUTOFIXER - Variables de Entorno
# ============================================
# Copia este archivo a .env.local y completa los valores

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Autofixer"
NEXT_PUBLIC_APP_DESCRIPTION="Servicio de aire acondicionado automotriz a domicilio"

# ============================================
# API BACKEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ============================================
# DATABASE (Neon PostgreSQL)
# ============================================
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ============================================
# AUTH (NextAuth.js)
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-uno-con-openssl-rand-base64-32"

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================
# EMAIL (Resend)
# ============================================
RESEND_API_KEY=""
EMAIL_FROM="Autofixer <notificaciones@autofixer.cl>"

# ============================================
# SMS/WHATSAPP (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WHATSAPP_NUMBER="+1234567890"

# ============================================
# PAYMENTS (Flow/Transbank)
# ============================================
FLOW_API_KEY=""
FLOW_COMMERCE_CODE=""
FLOW_SECRET_KEY=""
# Para WebPay
WEBPAY_COMMERCE_CODE=""
WEBPAY_PRIVATE_KEY=""
WEBPAY_CERTIFICATE=""

# ============================================
# MAPS (Google Maps)
# ============================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# ============================================
# ANALYTICS
# ============================================
NEXT_PUBLIC_GA_ID=""
HOTJAR_ID=""
